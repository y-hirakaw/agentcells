#!/bin/sh
# コミットしようとしている変更に秘密が入っていたら止める。
# 使うには: 中身を読んでから cp .githooks/pre-commit .git/hooks/pre-commit
# （core.hooksPath を .githooks に向けると、取り出したPRが足したフックも動くので向けない）
if ! command -v betterleaks >/dev/null 2>&1; then
  echo "betterleaksがありません。brew install betterleaks で入れてください" >&2
  exit 1
fi
exec betterleaks git --pre-commit --staged --no-banner --redact .
